# WordSnap
word snap
/* ==========================
   WordSnap V1
   style.css Part 1
========================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{

    font-family:
    "Pretendard",
    "Apple SD Gothic Neo",
    sans-serif;

    background:#f5f7fb;

    color:#333;

    min-height:100vh;

}

/* ---------- Header ---------- */

header{

    text-align:center;

    padding:40px 20px 20px;

}

header h1{

    font-size:2.3rem;

    color:#2563eb;

    margin-bottom:10px;

}

.subtitle{

    color:#666;

    font-size:15px;

}

/* ---------- Main ---------- */

main{

    width:95%;
    max-width:900px;

    margin:auto;

}

/* ---------- Upload ---------- */

.upload-section{

    margin-top:35px;
    margin-bottom:30px;

}

.upload-box{

    display:flex;

    justify-content:center;

    align-items:center;

    text-align:center;

    cursor:pointer;

    border:3px dashed #8bb9ff;

    background:white;

    border-radius:20px;

    padding:45px 20px;

    transition:.25s;

}

.upload-box:hover{

    background:#eef5ff;

    transform:translateY(-3px);

}

.upload-box input{

    display:none;

}

.camera{

    font-size:70px;

    display:block;

    margin-bottom:15px;

}

.upload-box h3{

    font-size:24px;

    margin-bottom:10px;

}

.upload-box p{

    color:#777;

}

/* ---------- Status ---------- */

.status{

    margin:25px 0;

    text-align:center;

}

#statusText{

    background:white;

    display:inline-block;

    padding:12px 22px;

    border-radius:50px;

    box-shadow:0 3px 10px rgba(0,0,0,.08);

    color:#555;

}

/* ---------- Title ---------- */

.title-row{

    display:flex;

    justify-content:space-between;

    align-items:center;

    margin-bottom:20px;

}

.title-row h2{

    font-size:26px;

}

/* ---------- Button ---------- */

#shuffleBtn{

    background:#2563eb;

    color:white;

    border:none;

    border-radius:12px;

    padding:12px 18px;

    cursor:pointer;

    font-size:15px;

    transition:.2s;

}

#shuffleBtn:hover{

    background:#1d4ed8;

    transform:scale(1.04);

}

/* ---------- Word Area ---------- */

#wordList{

    display:flex;

    flex-direction:column;

    gap:18px;

    margin-bottom:50px;

}

/* ---------- Footer ---------- */

footer{

    text-align:center;

    padding:40px;

    color:#999;

    font-size:14px;

}

/* ---------- Mobile ---------- */

@media(max-width:700px){

header{

padding-top:25px;

}

header h1{

font-size:1.8rem;

}

.subtitle{

font-size:13px;

}

.upload-box{

padding:35px 15px;

}

.camera{

font-size:55px;

}

.upload-box h3{

font-size:20px;

}

.title-row{

flex-direction:column;

gap:15px;

}

.title-row h2{

font-size:22px;

}

#shuffleBtn{

width:100%;

}

}
